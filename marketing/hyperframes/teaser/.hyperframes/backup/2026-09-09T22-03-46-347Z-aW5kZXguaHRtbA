<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Qualifire — brand teaser (HyperFrames)</title>
<style>
  html, body { margin: 0; padding: 0; background: #0A0A0A; }
  * { box-sizing: border-box; }

  #stage {
    position: relative;
    width: 1920px;
    height: 1080px;
    background: #0A0A0A;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #F4F2EC;
  }

  .clip { position: absolute; }

  /* ---- track 0: logo mark (ring + slash) ---- */
  #mark {
    top: 50%;
    left: 50%;
    width: 400px;
    height: 400px;
    margin: -200px 0 0 -200px;
    transform-origin: center center;
  }
  #mark .inner { width: 100%; height: 100%; opacity: 1; }
  #mark svg { width: 100%; height: 100%; display: block; }

  /* ---- track 1: wordmark + tagline ---- */
  #wordmark {
    top: 50%;
    left: 0;
    width: 1920px;
    text-align: center;
    transform: translateY(-40px);
  }
  #wordmark .inner { opacity: 0; }
  #wordmark .word {
    font-size: 96px;
    font-weight: 800;
    letter-spacing: 22px;
    color: #F4F2EC;
    margin: 0 0 22px 0;
    opacity: 0;
  }
  #wordmark .tagline {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: 1px;
    color: #9a978f;
    margin: 0;
    opacity: 0;
  }

  /* ---- track 2: sector slots ---- */
  #sectors {
    top: 640px;
    left: 0;
    width: 1920px;
  }
  #sectors .inner { display: flex; justify-content: center; gap: 40px; opacity: 0; }
  .sector {
    width: 360px;
    height: 220px;
    border-radius: 18px;
    border: 3px solid #232323;
    background: #141414;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    opacity: 0;
  }
  .sector .s-label {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 6px;
    color: #9a978f;
    text-transform: uppercase;
  }
  .sector .s-time {
    font-size: 64px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
    color: #F4F2EC;
  }

  /* ---- track 3: timing tower line ---- */
  #tower {
    top: 50%;
    left: 0;
    width: 1920px;
    text-align: center;
    transform: translateY(-30px);
  }
  #tower .inner { opacity: 0; }
  #tower .tower-pos {
    display: block;
    font-size: 160px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: #F5C542;
    line-height: 1;
    margin: 0 0 18px 0;
    opacity: 0;
  }
  #tower .tower-desc {
    display: block;
    font-size: 32px;
    font-weight: 500;
    letter-spacing: 1px;
    color: #9a978f;
    opacity: 0;
  }

  /* ---- track 4: endcard wordmark ---- */
  #endcard {
    top: 660px;
    left: 0;
    width: 1920px;
    text-align: center;
  }
  #endcard .inner { opacity: 0; }
  #endcard .endword {
    font-size: 84px;
    font-weight: 800;
    letter-spacing: 24px;
    color: #F5C542;
    margin: 0;
    opacity: 0;
  }

  /* logo mark starts undrawn: ring hidden by dash-offset (set in JS), slash hidden */
  #slash { opacity: 0; }
</style>
</head>
<body>

<div data-hf-id="hf-z6fr" id="stage" data-composition-id="teaser" data-start="0" data-width="1920" data-height="1080">

  <!-- track 0 — logo mark: ring draws clockwise + slash lands (0-2s), fades out in
       place at 2s (no shrink/slide) while the wordmark/sectors/tower play, fades back
       in centered for the endcard at 10.6s (no travel). Geometry inlined from
       product/brand/logos/qualifire_logo_5_monogram_wordmark.svg (ring cx/cy/r,
       slash x1/y1/x2/y2 — unscaled, same 512x512 viewBox). -->
  <div data-hf-id="hf-if9m" id="mark" class="clip" data-start="0" data-duration="12" data-track-index="0">
    <div data-hf-id="hf-lm34" class="inner">
      <svg data-hf-id="hf-2bub" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
        <circle data-hf-id="hf-lrl8" id="ring" cx="256" cy="218" r="118" fill="none" stroke="#F4F2EC" stroke-width="30" stroke-linecap="round" transform="rotate(-90 256 218)" />
        <line data-hf-id="hf-wvr5" id="slash" x1="291.355" y1="253.355" x2="387.5206" y2="349.5206" fill="none" stroke="#F5C542" stroke-width="30" stroke-linecap="round" />
      </svg>
    </div>
  </div>

  <!-- track 1 — wordmark + tagline (2-5s) -->
  <div data-hf-id="hf-hfuj" id="wordmark" class="clip" data-start="2" data-duration="3" data-track-index="1">
    <div data-hf-id="hf-bug8" class="inner">
      <p data-hf-id="hf-f7sf" class="word">QUALIFIRE</p>
      <p data-hf-id="hf-o21e" class="tagline">Same road. New meaning.</p>
    </div>
  </div>

  <!-- track 2 — four sector slots fill in sequence, yellow -> green -> yellow -> purple (5-9s) -->
  <div data-hf-id="hf-2nru" id="sectors" class="clip" data-start="5" data-duration="4" data-track-index="2">
    <div data-hf-id="hf-anj5" class="inner">
      <div data-hf-id="hf-81po" class="sector" id="s1"><span data-hf-id="hf-taqt" class="s-label">S1</span><span data-hf-id="hf-n6zd" class="s-time">38.2</span></div>
      <div data-hf-id="hf-ix7b" class="sector" id="s2"><span data-hf-id="hf-uhnw" class="s-label">S2</span><span data-hf-id="hf-z9z2" class="s-time">1:02.9</span></div>
      <div data-hf-id="hf-crhi" class="sector" id="s3"><span data-hf-id="hf-u3cv" class="s-label">S3</span><span data-hf-id="hf-rqam" class="s-time">27.7</span></div>
      <div data-hf-id="hf-nmz5" class="sector" id="s4"><span data-hf-id="hf-va9y" class="s-label">S4</span><span data-hf-id="hf-iv7a" class="s-time">51.0</span></div>
    </div>
  </div>

  <!-- track 3 — timing-tower line (9-10.6s) -->
  <div data-hf-id="hf-7nys" id="tower" class="clip" data-start="9" data-duration="1.6" data-track-index="3">
    <div data-hf-id="hf-b1u6" class="inner">
      <span data-hf-id="hf-vfar" class="tower-pos">P2</span>
      <span data-hf-id="hf-0ajs" class="tower-desc">of your last 10 rides</span>
    </div>
  </div>

  <!-- track 4 — yellow QUALIFIRE endcard, plays under the re-faded-in mark (10.6-12s) -->
  <div data-hf-id="hf-t03d" id="endcard" class="clip" data-start="10.6" data-duration="1.4" data-track-index="4">
    <div data-hf-id="hf-9ux3" class="inner">
      <p data-hf-id="hf-mw7o" class="endword">QUALIFIRE</p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
  <script>
    // One paused, seekable GSAP timeline for the whole composition — no
    // wall-clock animation, everything driven by absolute-time tweens so the
    // HyperFrames renderer can seek to any frame deterministically.
    var RING_R = 118;
    var CIRC = 2 * Math.PI * RING_R; // ~741.42
    gsap.set('#ring', { strokeDasharray: CIRC });
    var tl = gsap.timeline({ paused: true });

    // 0–1.65 gate draws
    tl.fromTo('#ring', { strokeDashoffset: CIRC }, { strokeDashoffset: 0, duration: 1.3, ease: 'power2.inOut' }, 0);
    tl.fromTo('#slash', { opacity: 0 }, { opacity: 1, duration: 0.35, ease: 'power1.out' }, 1.3);

    // 2.0 mark FADES OUT in place (no shrink/slide) — Nathan's feedback: "better to fade it out
    // and just let the name + tagline fill its place" instead of shrinking to a corner badge
    tl.to('#mark .inner', { opacity: 0, duration: 0.5, ease: 'power1.inOut' }, 2.0);
    tl.set('#mark .inner', { opacity: 0 }, 2.5);

    tl.set('#wordmark .inner', { opacity: 1 }, 2.0);
    tl.fromTo('#wordmark .word', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 2.0);
    tl.fromTo('#wordmark .tagline', { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 2.25);
    tl.to('#wordmark .inner', { opacity: 0, duration: 0.35 }, 4.65);
    tl.set('#wordmark .inner', { opacity: 0 }, 5.0);

    var SECTOR_COLORS = ['#F5C542', '#3ED598', '#F5C542', '#A667F0'];
    var NEUTRAL_BORDER = '#232323';
    var NEUTRAL_TEXT = '#F4F2EC';
    tl.set('#sectors .inner', { opacity: 1 }, 5.0);
    ['#s1', '#s2', '#s3', '#s4'].forEach(function (sel, i) {
      var t = 5.0 + i;
      var tier = SECTOR_COLORS[i];
      tl.fromTo(sel, { opacity: 0, y: 16, borderColor: NEUTRAL_BORDER },
        { opacity: 1, y: 0, borderColor: tier, duration: 0.35, ease: 'back.out(1.6)' }, t);
      tl.fromTo(sel + ' .s-time', { color: NEUTRAL_TEXT }, { color: tier, duration: 0.35, ease: 'back.out(1.6)' }, t);
    });
    tl.to('#sectors .inner', { opacity: 0, duration: 0.3 }, 8.7);
    tl.set('#sectors .inner', { opacity: 0 }, 9.0);

    tl.set('#tower .inner', { opacity: 1 }, 9.0);
    tl.fromTo('#tower .tower-pos', { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.4, ease: 'power2.out' }, 9.0);
    tl.fromTo('#tower .tower-desc', { opacity: 0 }, { opacity: 1, duration: 0.4 }, 9.25);
    tl.to('#tower .inner', { opacity: 0, duration: 0.3 }, 10.3);
    tl.set('#tower .inner', { opacity: 0 }, 10.6);

    // 10.6 endcard: mark FADES IN centered, full size (no travel) — Nathan: "just fade it in
    // instead of bringing it from the corner"
    tl.to('#mark .inner', { opacity: 1, duration: 0.5, ease: 'power1.out' }, 10.6);
    tl.set('#endcard .inner', { opacity: 1 }, 10.6);
    tl.fromTo('#endcard .endword', { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 10.7);

    window.__timelines = window.__timelines || {};
    window.__timelines.teaser = tl;
  </script>

</div>

</body>
</html>
